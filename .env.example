# ============================================================================
# Plataforma de Infraestructura v22 · Configuración de servidor
# Copia este archivo como .env y cambia SOLO lo necesario.
# NO compartas .env ni credenciales reales.
# ============================================================================
INFRA_HOST=0.0.0.0
INFRA_PORT=8000
WORK_TIMEZONE=America/Mexico_City
SESSION_HOURS=12
COOKIE_SECURE=false

# PostgreSQL 18+ (RECOMENDADO).
# La forma más fácil en Windows es usar estos campos separados:
# INFRA_DB_BACKEND=postgresql
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=infraestructura_db
# PGUSER=infraestructura_app
# PGPASSWORD=CAMBIAR_POR_TU_PASSWORD
#
# Alternativa avanzada: DATABASE_URL=postgresql://usuario:password@host:5432/bd
# Si ninguna opción PostgreSQL está configurada, el sistema usa SQLite.
INFRA_DB_BACKEND=
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
DATABASE_URL=

# Odoo
ODOO_API_MODE=xmlrpc
ODOO_URL=https://TU_EMPRESA.odoo.com
ODOO_DB=TU_BASE
ODOO_USER=integracion@example.com
ODOO_API_KEY=CAMBIAR
ODOO_HELPDESK_MODEL=helpdesk.ticket
ODOO_HELPDESK_FIELDS_JSON=["id","name","create_date","write_date"]
ODOO_SYNC_LIMIT=5000

# Google Workspace / Drive / Calendar
GOOGLE_SERVICE_ACCOUNT_FILE=C:\\ruta\\segura\\service-account.json
GOOGLE_IMPERSONATE_USER=servicio@example.com
GOOGLE_DRIVE_FOLDER_ID=ID_DE_CARPETA_EN_SHARED_DRIVE
# Calendario dedicado de días NO laborables. Los eventos deben ser de día completo.
GOOGLE_NON_WORKING_CALENDAR_ID=
KEEP_LOCAL_UPLOADS=false
